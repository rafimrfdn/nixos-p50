# Colors
# class                 border  backgr. text    indicator child_border
client.focused          #999999 #5f676a #999999 #999999   #999999
client.focused_inactive #999999 #5f676a #999999 #999999   #999999
client.unfocused        #333333 #222222 #888888 #292d2e   #1f1e1e
client.urgent           #999999 #5f676a #999999 #999999   #999999
client.placeholder      #000000 #0c0c0c #ffffff #000000   #0c0c0c

client.background       #ffffff

default_border pixel 1

# Screenshots
bindsym Shift+Print exec grim  -g "$(slurp)" /home/nix/Pictures/Screenshot-$(date +'%H:%M:%S.png')
bindsym Print exec grim /home/nix/Pictures/Screenshot-$(date +'%H:%M:%S.png')
bindsym Ctrl+Print exec grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type?) | select(.focused).rect | "\(.x),\(.y) \(.width)x\(.height)"')" /home/nix/Pictures/Screenshot-$(date +'%H:%M:%S.png')

