{config, pkgs, lib, ...}:

{
  programs.zsh = {
    enable = true;
    autosuggestion.enable = true;
    enableCompletion = true;
    syntaxHighlighting = {
      enable = true;
      package = pkgs.zsh-syntax-highlighting;
    };
    initExtra = ''
      # everything will be easy when you can use vim keybind on terminal
      bindkey -v

      PROMPT='%F{226}%~%f '
      
      export CLICOLOR=1
      export LSCOLORS=ExGxBxDxCxEgEdxbxgxcxd
      alias ll="ls -alG"
      alias ls="exa"
      alias cat="bat"

      alias alphp="./.alphp/7.4-full/bin/alphp"
      
      export EDITOR=nvim
      export PATH="$HOME/.config/emacs/bin:$PATH"
      
      alias hs="hugo server --renderToMemory"
      alias hse="hugo serve --environment production"
      alias nrs="npm run start"
      alias dev="npm run dev"
      
      #TMUX
      alias ta="tmux attach -t"
      alias tn="tmux new-session -s"
      #alias tk="tmux kill-session -t"
      alias tl="tmux list-sessions"
      alias td="tmux detach"
      alias tc="clear; tmux clear-history; clear"
      
      bindkey "^[[3~" delete-char
    '';

    profileExtra = ''
    case $(basename "$(tty)" ) in  
    tty1)
    # WLR_NO_HARDWARE_CURSORS=1 exec Hyprland #prevents cursor disappear when using Nvidia drivers
    exec sway
    ;;
    #tty2)
    #exec Hyprland
    #;;
    esac
    '';

  };
}
